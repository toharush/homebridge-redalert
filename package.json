{
  "displayName": "Red Alert (Pikud HaOref)",
  "name": "@toharush/homebridge-redalert",
  "version": "2.2.0",
  "author": {
    "name": "Tohar Harush",
    "url": "https://github.com/toharush"
  },
  "description": "Homebridge plugin for Israel Red Alert (Tzeva Adom, צבע אדום) from Pikud HaOref / Home Front Command (פיקוד העורף): rocket, missile and UAV alerts as HomeKit sensors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toharush/homebridge-redalert.git"
  },
  "bugs": {
    "url": "https://github.com/toharush/homebridge-redalert/issues"
  },
  "homepage": "https://github.com/toharush/homebridge-redalert#readme",
  "engines": {
    "node": "^22 || ^24 || ^25",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "assets/fonts/",
    "assets/fallback-alert.jpg",
    "config.schema.json",
    "homebridge-ui/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src/ --max-warnings=20",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc && npm run copy-data",
    "copy-data": "mkdir -p dist/data && cp src/data/cities.json dist/data/",
    "test": "tsx --test 'src/**/*.spec.ts'",
    "mock": "tsx mock-server.ts",
    "test:connectivity": "tsx --test src/clients/connectivity.test.ts",
    "prepublishOnly": "npm run lint && npm run build",
    "first-publish": "npm publish --access public"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "red-alert",
    "redalert",
    "red",
    "alert",
    "tzeva-adom",
    "tzevaadom",
    "color-red",
    "pikud-haoref",
    "pikud",
    "haoref",
    "oref",
    "home-front-command",
    "צבע-אדום",
    "פיקוד-העורף",
    "israel",
    "alerts",
    "rocket-alert",
    "missile-alert",
    "rocket",
    "missile",
    "uav",
    "air-raid",
    "siren",
    "tzofar",
    "security",
    "smart-home",
    "home-automation",
    "homebridge-redalert",
    "homebridge-red-alert",
    "apple-tv",
    "appletv",
    "tvos",
    "doorbell"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "lodash": "^4.18.1",
    "teleproto": "^1.229.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "ip-address": "^10.7.4"
  }
}
